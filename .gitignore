# Environments and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/
.env

# Data and derived artifacts never enter the repository.
# The real data directory is outside the repo (GREENROOM_DATA_DIR); these patterns are a second fence.
data/
derived/
outputs/
gold/
models/
hf_cache/

# Media of any kind
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.wav
*.mp3
*.m4a
*.flac
*.jpg
*.jpeg
*.png
*.gif
*.webp

# Databases and logs that may carry record content
*.db
*.sqlite
*.sqlite3
*.jsonl
*.log

# Samples for public artifacts are allowed only when generated from team-recorded footage (D9)
!samples/*.json
!samples/*.jsonld
!samples/*.csv
